<UserControl x:Class="CineTrack.MVVM.View.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CineTrack.MVVM.View"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#F5F5F5">
    <!-- Fond clair pour un look moderne -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10">
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Background="White">
                <TextBox x:Name="SearchBox" Width="300" Height="40" VerticalContentAlignment="Center"
                         Margin="5" Focusable="True" AcceptsReturn="True"
                         Background="Transparent" Foreground="#333333" FontSize="16" Padding="10"
                         GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus"/>
            </Border>
            <Button Content="Rechercher" Width="120" Height="40" Margin="10,0,0,0"
                    Click="SearchButton_Click" Background="#0078D4" Foreground="White" BorderBrush="#0078D4">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <ListBox x:Name="ResultsList" SelectionChanged="ResultsList_SelectionChanged" Grid.Row="1" Margin="10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1" Margin="5" Padding="10" CornerRadius="5" Background="White">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding PosterPath}" Width="80" Height="120" Margin="5"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Foreground="#333333"/>
                                <TextBlock Text="{Binding ReleaseYear}" FontStyle="Italic" FontSize="14" Foreground="#555555"/>
                                <TextBlock Text="{Binding MediaType}" Foreground="Gray" FontSize="14"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</UserControl>
