<UserControl x:Class="CineTrack.MVVM.View.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CineTrack.MVVM.View"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#F5F5F5">

    <UserControl.Resources>
        <!-- Effet d'ombre doux pour les cartes -->
        <DropShadowEffect x:Key="ShadowEffect"
                          Color="Black"
                          BlurRadius="8"
                          ShadowDepth="2"
                          Opacity="0.2" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 🔍 Zone recherche -->
            <RowDefinition Height="*"/>
            <!-- 🎞️ Résultats -->
        </Grid.RowDefinitions>

        <!-- 🔍 Barre de recherche -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10">
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Background="White">
                <TextBox x:Name="SearchBox"
                         Width="300"
                         Height="40"
                         VerticalContentAlignment="Center"
                         Margin="5"
                         Background="Transparent"
                         Foreground="#333333"
                         FontSize="16"
                         Padding="10"
                         GotFocus="SearchBox_GotFocus"
                         LostFocus="SearchBox_LostFocus" />
            </Border>

            <Button Content="Rechercher"
                    Width="120"
                    Height="40"
                    Margin="10,0,0,0"
                    Click="SearchButton_Click"
                    Background="#0078D4"
                    Foreground="White"
                    BorderBrush="#0078D4">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- 🎞️ Liste des résultats -->
        <ListBox x:Name="ResultsList"
                 Grid.Row="1"
                 SelectionChanged="ResultsList_SelectionChanged"
                 Margin="10"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="10" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Top" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White"
                            CornerRadius="10"
                            BorderBrush="#DDD"
                            BorderThickness="1"
                            Width="180"
                            Padding="8"
                            Effect="{StaticResource ShadowEffect}">
                        <StackPanel>
                            <Image Source="{Binding PosterPath}"
                                   Height="250"
                                   Stretch="UniformToFill"
                                   Margin="0 0 0 8"
                                   ClipToBounds="True" />
                            <TextBlock Text="{Binding Title}"
                                       TextWrapping="Wrap"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       TextAlignment="Center"
                                       Margin="4,0,4,2" />
                            <TextBlock Text="{Binding ReleaseYear}"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       Foreground="Gray"
                                       TextAlignment="Center" />
                            <TextBlock Text="{Binding MediaType}"
                                       FontSize="12"
                                       Foreground="DarkSlateGray"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
