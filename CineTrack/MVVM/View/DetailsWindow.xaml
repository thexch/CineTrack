<Window x:Class="CineTrack.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CineTrack"
        mc:Ignorable="d"
        Height="500" Width="850"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True">

    <!-- 🎨 STYLES PERSONNALISÉS -->
    <Window.Resources>

        <!-- ScrollBar custom avec Thumb stylée -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand"
                                                  Background="Transparent"
                                                  IsEnabled="False"
                                                  Height="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#FF3C3C" CornerRadius="4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand"
                                                  Background="Transparent"
                                                  IsEnabled="False"
                                                  Height="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style de bouton personnalisé -->
        <Style x:Key="StyledButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3C3B4D"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#FF3C3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3C3C"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- 🌌 Fenêtre principale -->
    <Border Background="#1E1B2E" CornerRadius="20" Padding="10" BorderBrush="#FF3C3C" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barre supérieure -->
            <Grid Grid.Row="0" Background="#2C293A" MouseDown="Grid_MouseDown">
                <TextBlock Text="Détails"
                           FontSize="22"
                           Foreground="White"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"
                           FontFamily="/Fonts/#Poppins"/>

                <Button Content="✕"
                        Width="30"
                        Height="30"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="White"
                        FontSize="18"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- Contenu principal -->
            <Grid Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Source="{Binding PosterPath}" Width="200" Height="300" Margin="10"/>

                <!-- ScrollViewer pour éviter que le contenu dépasse -->
                <ScrollViewer Grid.Column="1" Margin="20,0,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="26" Foreground="White" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding ReleaseYear}" FontStyle="Italic" FontSize="18" Foreground="#CCCCCC" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding Overview}" TextWrapping="Wrap" FontSize="16" Foreground="#E0E0E0" Margin="0,0,0,10"/>

                        <!-- Note formatée -->
                        <TextBlock FontSize="16" Foreground="White" Margin="0,0,0,5">
                            <Run Text="Note : " FontWeight="Bold"/>
                            <Run Text="{Binding Rating, StringFormat={}{0:0.0}}"/>
                            <Run Text="/10"/>
                        </TextBlock>

                        <TextBlock Text="{Binding MainActors}" FontSize="16" Foreground="White" Margin="0,0,0,15"/>

                        <!-- Boutons de tri -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Content="À voir" Click="MarkAsTowatch_Click" Style="{StaticResource StyledButton}" Margin="5"/>
                            <Button Content="En cours" Click="MarkAsInProgress_Click" Style="{StaticResource StyledButton}" Margin="5"/>
                            <Button Content="Déjà vu" Click="MarkAsWatched_Click" Style="{StaticResource StyledButton}" Margin="5"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Popup de confirmation -->
            <Popup Name="ConfirmationPopup" Width="300" Height="150" IsOpen="False" Placement="Center">
                <Border Background="#2C293A" CornerRadius="10" BorderBrush="#FF3C3C" BorderThickness="2" Padding="20">
                    <StackPanel>
                        <TextBlock Name="PopupMessage"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="10"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
